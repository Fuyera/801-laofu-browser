{
  "name": "laofu-browser",
  "version": "0.1.0-dev.3",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "engine": "node scripts/build-engine.mjs",
    "build": "node scripts/build-info.mjs && npm run engine && tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/cli.js serve",
    "dev": "tsx src/cli.ts serve",
    "verify:baseline": "node scripts/verify-baseline.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "@fastify/websocket": "11.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@novnc/novnc": "1.7.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "archiver": "7.0.1",
    "better-sqlite3": "12.11.1",
    "cheerio": "1.2.0",
    "fastify": "5.12.4",
    "ipaddr.js": "2.5.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/archiver": "6.0.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
